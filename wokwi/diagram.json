    [ "temp_hot:DQ", "esp:4", "green", [] ],
    [ "r_hot:1", "esp:3V3", "red", [] ],
    [ "r_hot:2", "esp:4", "green", [] ],

    [ "temp_cold:GND", "esp:GND.2", "black", [] ],
    [ "temp_cold:VCC", "esp:3V3", "red", [] ],
    [ "temp_cold:DQ", "esp:5", "blue", [] ],
    [ "r_cold:1", "esp:3V3", "red", [] ],
    [ "r_cold:2", "esp:5", "blue", [] ],

    [ "light:VCC", "esp:3V3", "red", [] ],
    [ "light:GND", "esp:GND.1", "black", [] ],
    [ "light:AO", "esp:34", "orange", [] ],

    [ "door:2", "esp:27", "violet", [] ],
    [ "door:1", "esp:GND.3", "black", [] ]
  ],
  "dependencies": {}
