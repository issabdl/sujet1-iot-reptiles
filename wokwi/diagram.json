{
  "version": 1,
  "author": "issabdl",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ds18b20", "id": "temp_hot", "top": -134.4, "left": 220, "attrs": { "temperature": "38" } },
    { "type": "board-ds18b20", "id": "temp_cold", "top": -134.4, "left": 320, "attrs": { "temperature": "27" } },
    { "type": "wokwi-resistor", "id": "r_hot", "top": -40, "left": 200, "rotate": 90, "attrs": { "value": "4700" } },
    { "type": "wokwi-resistor", "id": "r_cold", "top": -40, "left": 300, "rotate": 90, "attrs": { "value": "4700" } },
    { "type": "wokwi-photoresistor-sensor", "id": "light", "top": 160, "left": -250, "attrs": {} },
